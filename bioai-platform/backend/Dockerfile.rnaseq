FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base-core r-bioc-deseq2 r-bioc-tximport r-bioc-complexheatmap \
    r-cran-ggplot2 r-cran-jsonlite r-cran-circlize r-bioc-go.db r-bioc-org.hs.eg.db \
    r-cran-biocmanager r-cran-bh r-cran-rcpp r-cran-data.table r-cran-cowplot r-cran-fastmatch build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN Rscript -e 'for (p in c("DESeq2","tximport","ComplexHeatmap","ggplot2","jsonlite","circlize")) stopifnot(requireNamespace(p, quietly=TRUE))'
RUN Rscript -e 'BiocManager::install("fgsea", ask=FALSE, update=FALSE); stopifnot(requireNamespace("fgsea", quietly=TRUE))'
RUN pip install --no-cache-dir supabase python-dotenv
WORKDIR /app
COPY app ./app
COPY tests/test_preranked_gsea.R /tmp/test_preranked_gsea.R
RUN Rscript /tmp/test_preranked_gsea.R
ENV BIONEXUS_EXPRESSION_ROOT=/var/lib/bionexus-expression
VOLUME ["/var/lib/bionexus-expression"]
CMD ["python", "-m", "app.rnaseq.durable"]
