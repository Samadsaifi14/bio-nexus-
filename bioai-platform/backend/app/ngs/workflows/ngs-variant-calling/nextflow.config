process {
    executor      = 'local'
    cpus          = 1
    memory        = '1 GB'
    errorStrategy = 'terminate'
}

// Default: Nextflow runs inside the bionexus/ngs-tools image, so process-level
// containers are not used. On a host with Nextflow + Docker, enable the docker
// profile to run each process in the same tool image.
docker.enabled = false

profiles {
    docker {
        docker.enabled = true
        process.container = 'bionexus/ngs-tools:1.0'
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    fields  = 'task_id,hash,name,status,exit,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,read_bytes,write_bytes,workdir'
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}
